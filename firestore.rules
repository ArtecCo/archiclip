rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /clips/{clipId} {
      allow read: if true;

      allow create: if
        request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.expiresAt is number
        || (
          request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6
          && request.resource.data.expiresAt == null
        );

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /adminMetrics/{metricId} {
      allow read, write: if isAdmin();
    }
  }
}
